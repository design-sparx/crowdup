# Server-side only. Read in loaders/actions via process.env; never bundled for the browser
# (nothing here uses the VITE_ prefix).

# Supabase project URL. Local `supabase start` default shown.
SUPABASE_URL=http://127.0.0.1:54321
# Supabase anon (publishable) key. `supabase status` prints it for local development.
SUPABASE_ANON_KEY=

# Optional. Public origin of this app, used for email links and OAuth redirects.
# Defaults to the request origin. Set it behind proxies. Must be allowed in Supabase
# Auth "Redirect URLs".
SITE_URL=http://localhost:5173

# Set to "true" to show Google sign-in. Also enable the Google provider in Supabase
# (supabase/config.toml [auth.external.google] locally, dashboard in hosted projects).
AUTH_GOOGLE_ENABLED=false



# --- Stripe Connect (organiser onboarding) ---------------------------------------------
# Server-side secret key. Use a TEST key (sk_test_...) until you are ready for real money.
# Never commit it and never expose it to the browser.
STRIPE_SECRET_KEY=
# Signing secret of the Connect webhook endpoint (whsec_...). Needed for POST /api/stripe/webhook.
# Local: `stripe listen --forward-connect-to localhost:5173/api/stripe/webhook` prints it.
STRIPE_WEBHOOK_SECRET=

# Platform fee on each donation, as a percentage (0 to 30, max 2 decimals). Default 0: no
# application fee is sent to Stripe. Example: 2.5
PLATFORM_FEE_PERCENT=0

# "auto" (default): a draft goes live as soon as its organiser finishes Stripe onboarding.
# "approval": it moves to pending_approval and waits in the admin queue (/admin/approvals)
# until an administrator approves it (live) or rejects it with a reason. See docs/moderation.md.
# Any other value is an error.
PUBLISHING_MODE=auto

# SERVER ONLY. Bypasses row-level security; used to write Stripe fields and publish drafts.
# Anyone holding it can read and change all data. Local value: `supabase status`.
SUPABASE_SERVICE_ROLE_KEY=

# --- Public demo (leave off for real instances) ---
# "true" shows a banner: demo, Stripe test mode, test card, scheduled reset. Needs sk_test_ key,
# otherwise a red warning shows instead. See docs/demo.md.
DEMO_MODE=false

# --- Only for tests and the demo reset workflow (not read by the deployed app) ---------
# Demo reset (GitHub Actions secrets, see docs/demo.md): Postgres URL of the DEMO project and
# its project ref. Never point these at a real instance.
# DEMO_DATABASE_URL=
# DEMO_RESET_CONFIRM_PROJECT_REF=

# Playwright (pnpm test:e2e). Optional. Some specs skip when their variable is unset.
# PLAYWRIGHT_CHROMIUM_PATH=   # use an existing Chromium instead of the Playwright one
# E2E_ORGANISER_PASSWORD=     # dashboard spec, see docs/demo.md
# E2E_DONOR_PASSWORD=         # my-donations spec
# E2E_EMAIL=
# E2E_PASSWORD=
# E2E_LIVE_EDIT_URL=          # lifecycle spec: edit URL of a live campaign
# E2E_DONATE_CAMPAIGN_URL=    # donate spec: URL of a live campaign
